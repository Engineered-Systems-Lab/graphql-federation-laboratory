# Placeholders only, never a real secret. Copy to .env (ignore it in Git: do not commit it) or export these in the
# shell, and choose your own values. Compose refuses to start when either one is missing or empty.
#
# The admin password is read by the database image the first time it initialises its volume, and by the one-shot
# bootstrap container; the service never receives it. The service password is the one login the service uses: the
# bootstrap container sets it on every start.
ASSETS_DB_ADMIN_PASSWORD=change-me-admin
ASSETS_DB_SERVICE_PASSWORD=change-me-service
# Optional: the loopback port the service is published on (default 8084).
# ASSETS_HOST_PORT=8084
