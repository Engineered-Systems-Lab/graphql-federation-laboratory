{
  "about": "Example of the machine-local study config (copy it outside the repository, fill the placeholders, point STUDY_CONFIG or --config at the copy). A command is {argv, cwd?, env?, background?}; the stack commands run with the API keys stripped from their environment. Placeholders in angle brackets are filled on the machine; nothing here names a repository path. Every scenario declares its provenance: the compose projects to observe, the intended backends (mode real or simulated, the compose service, the image id and/or ref from docker inspect, the dataset with its SHA-256), the routing (each upstream URL the MCP server calls with the compose service that publishes it, and each adapter's backend URL variables) and the launch files to hash. The harness compares them with the running stack before any paid request.",
  "task_set": "dev",
  "scenario_order": ["alpha", "beta", "gamma", "delta", "epsilon"],
  "models": ["claude-sonnet-5-5", "gpt-6.1-sol"],
  "trials": 2,
  "seed": 20261021,
  "warmup_passes": 3,
  "limits": {"max_tool_calls": 40, "max_wall_seconds": 900, "max_task_tokens": 400000, "max_nudges": 2, "max_retries": 3, "retry_backoff_seconds": 5},
  "budgets": {
    "anthropic": {"tokens": 0, "dollar_ceiling": 20.0},
    "openai": {"tokens": 0, "dollar_ceiling": 20.0}
  },
  "scenarios": {
    "alpha": {
      "mcp_url": "http://127.0.0.1:8191/mcp",
      "ready_timeout_seconds": 300,
      "warmup_calls": [{"tool": "read_mapping_release", "arguments": {"release": "1.3"}}],
      "stack": {
        "start": [
          {"argv": ["<stack start command>"], "cwd": "<stack folder>"},
          {"argv": ["<mcp venv python>", "-B", "<study/mcp>/raw_server.py", "--mapping-dir", "<mapping releases folder>"], "background": true}
        ],
        "stop_service": {"assets": [{"argv": ["<stop the assets service>"]}], "personnel": [{"argv": ["<stop the personnel service>"]}]},
        "start_service": {"assets": [{"argv": ["<start the assets service>"]}], "personnel": [{"argv": ["<start the personnel service>"]}]},
        "teardown": [{"argv": ["<stack teardown command>"], "cwd": "<stack folder>"}]
      },
      "provenance": {
        "compose_projects": ["starfleet-missions", "starfleet-federation-stack"],
        "backends": {
          "missions": {"mode": "real", "service": "starfleet-missions/missions", "image_id": "<sha256:... image id of the Missions service>",
                       "image_ref": "starfleet-missions-service:1.0.0"},
          "assets": {"mode": "real", "service": "assets-service", "image_id": "<sha256:... image id>",
                     "dataset": {"id": "assets-1.1", "path": "<assets dataset release folder>", "sha256": "<its SHA-256 as the harness hashes it>"}},
          "personnel": {"mode": "real", "service": "personnel-service", "image_ref": "starfleet-federation-stack-personnel-service:2.0.0"}
        },
        "routing": {
          "endpoints": {"http://127.0.0.1:8083/": "starfleet-missions/missions"}
        },
        "launch_files": {"stack_start": "<path of the stack start script>", "compose": "<path of the compose file>"}
      }
    },
    "beta": {"mcp_url": "http://127.0.0.1:8191/mcp", "guide_file": "<path of the frozen guide>", "stack": {},
             "provenance": {"compose_projects": ["starfleet-missions"],
                            "backends": {"missions": {"mode": "real", "service": "missions", "image_ref": "starfleet-missions-service:1.0.0"}}}},
    "gamma": {"mcp_url": "http://127.0.0.1:8192/mcp", "stack": {},
              "provenance": {"compose_projects": ["starfleet-missions", "starfleet-federation-stack"],
                             "backends": {"missions": {"mode": "real", "service": "starfleet-missions/missions", "image_ref": "starfleet-missions-service:1.0.0"}},
                             "routing": {"endpoints": {"http://127.0.0.1:8183/graphql": "missions-adapter"},
                                         "env": {"missions-adapter": {"MISSIONS_SERVICE_URL": "http://host.docker.internal:8083"}}}}},
    "delta": {"mcp_url": "http://127.0.0.1:8193/mcp", "stack": {},
              "provenance": {"compose_projects": ["starfleet-missions", "starfleet-federation-stack"],
                             "backends": {"missions": {"mode": "real", "service": "starfleet-missions/missions", "image_ref": "starfleet-missions-service:1.0.0"}},
                             "routing": {"endpoints": {"http://127.0.0.1:8170/": "router"},
                                         "env": {"missions-adapter": {"MISSIONS_SERVICE_URL": "http://host.docker.internal:8083"}}}}},
    "epsilon": {"mcp_url": "http://127.0.0.1:8194/mcp", "stack": {},
                "provenance": {"compose_projects": ["starfleet-missions", "starfleet-federation-stack"],
                               "backends": {"missions": {"mode": "real", "service": "starfleet-missions/missions", "image_ref": "starfleet-missions-service:1.0.0"}},
                               "routing": {"endpoints": {"http://127.0.0.1:8171/": "cosmo-router"},
                                           "env": {"missions-adapter": {"MISSIONS_SERVICE_URL": "http://host.docker.internal:8083"}}}}}
  },
  "telemetry": {"apollo_router": "anonymous telemetry off (APOLLO_TELEMETRY_DISABLED)", "cosmo_router": "anonymous telemetry off (COSMO_TELEMETRY_DISABLED)"},
  "declared_settings": {
    "apollo_router": {"version": "v2.18.0", "supergraph.introspection": true, "default": "off"},
    "cosmo_router": {"version": "0.359.0", "introspection.enabled": true, "default": "on"},
    "adapters": "answer __schema on their own endpoints unchanged; the MCP servers hide _service and _entities"
  },
  "facts_commands": {"docker_version": ["docker", "version", "--format", "{{.Server.Version}}"]},
  "hash_files": {"mapping_release_1_3_manifest": "<path of a dataset file to hash>"}
}
