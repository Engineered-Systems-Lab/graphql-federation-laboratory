<?xml version="1.0" encoding="UTF-8"?>
<!--
  The parent of the federation layer: Java 21, Maven, the pinned versions and the modules.
  Versions (resolved 2026-10-16 against Maven Central; see federation/adapters/assets/README.md):
    Spring Boot 3.4.13 (experiment 1 used 3.4.5; 3.4.13 is the newest 3.4 patch), which manages Spring for GraphQL 1.3.7;
    graphql-java is held at 22.3, the version federation-jvm 5.4.0 declares and the experiments ran (Boot 3.4.13 manages 22.4);
    federation-graphql-java-support 5.4.0, the version of the experiments.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.13</version>
    <relativePath/>
  </parent>

  <groupId>lab.federation</groupId>
  <artifactId>federation-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>federation-parent</name>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <graphql-java.version>22.3</graphql-java.version>
    <federation-jvm.version>5.4.0</federation-jvm.version>
  </properties>

  <modules>
    <module>common</module>
    <module>adapters/missions</module>
    <module>adapters/personnel</module>
    <module>adapters/assets</module>
    <module>adapters/mapping</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>lab.federation</groupId>
        <artifactId>federation-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apollographql.federation</groupId>
        <artifactId>federation-graphql-java-support</artifactId>
        <version>${federation-jvm.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
